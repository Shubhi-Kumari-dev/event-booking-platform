# ==============================================================================
# Eventify — Environment Configuration Example
# Copy this file to .env and replace with your own values
# ==============================================================================

# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-sample.aws.neon.tech/neondb?sslmode=require"

# NextAuth Authentication
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-random-32-char-key"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary (Optional - For event banner image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (Optional - For transactional booking confirmation emails)
RESEND_API_KEY=""
EMAIL_FROM="Eventify <onboarding@resend.dev>"
